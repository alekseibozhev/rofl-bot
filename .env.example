TELEGRAM_BOT_TOKEN=put_token_here
# Required: groups where this bot may respond, comma-separated negative Telegram IDs.
ALLOWED_GROUP_ID=
# Optional HTTP proxy for Telegram, OpenRouter, OpenAI, and Google News. Local SearXNG & Ollama connect directly.
https_proxy=http://192.168.1.1:7897
# READ_ONLY=1

# OpenRouter (recommended: anthropic/claude-haiku-5.5, deepseek/deepseek-v4.1-flash-1017, x-ai/grok-4.7)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Optional: direct OpenAI API (takes precedence over OPENROUTER_MODEL)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.2-sol
# OPENAI_BASE_URL=https://api.openai.com/v1

# Reasoning effort: medium (default, reliable tool use), low, minimal, none, high
WRITER_EFFORT=medium

# Optional local Ollama fallback (no tool calling) if neither OPENAI_MODEL nor OPENROUTER_MODEL is set
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=orcarouter/Qwen3.8-27B-Uncensored:mlx-4bit

# Required for Docker Compose SearXNG: python3 -c 'import secrets; print("SEARXNG_SECRET=" + secrets.token_hex(32))'
SEARXNG_SECRET=replace_with_a_random_value
# Timezone inside the bot container
TZ=Europe/Moscow
