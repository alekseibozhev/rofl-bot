TELEGRAM_BOT_TOKEN=put_token_here
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=orcarouter/Qwen3.8-27B-Uncensored:mlx-4bit
# Required: groups where this bot may respond, comma-separated negative Telegram IDs.
ALLOWED_GROUP_ID=
# Optional: what a group reads about in the morning news, «ID:interest» comma-separated; the rest read about AI.
# NEWS=-100500:games
# Optional HTTP proxy for Telegram. Ollama always connects directly.
https_proxy=http://192.168.1.1:7897
# READ_ONLY=1
# Optional: answer with an OpenRouter model instead of Ollama. Goes through https_proxy.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
