TELEGRAM_BOT_TOKEN=put_token_here
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=orcarouter/Qwen3.8-27B-Uncensored:mlx-4bit
# Required: groups where this bot may respond, comma-separated negative Telegram IDs.
ALLOWED_GROUP_ID=
# Optional: what a group reads about in the morning news, «ID:interest» comma-separated; the rest read about AI.
# NEWS=-100500:games
# Optional HTTP proxy for Telegram. Ollama always connects directly.
https_proxy=http://192.168.1.1:7897
# READ_ONLY=1
# Optional: answer with an OpenRouter model instead of Ollama. Goes through https_proxy.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta/muse-spark-1.3-contributor
# Optional: answer directly with an OpenAI model (takes precedence over OPENROUTER_MODEL; Jev still uses OPENROUTER_API_KEY).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.2-astra
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional writer reasoning effort (default: high on OpenRouter; e.g. low for gpt-6.2-astra or medium for gpt-6.2-sol)
# and query-rewriter model (defaults to the active writer model).
# WRITER_EFFORT=low
# QUERY_MODEL=gpt-6.2-sol

# Optional additional model formatting; local Markdown rendering is free by default.
# FORMATTER_ENABLED=1
